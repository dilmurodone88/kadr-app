# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=kadr_db
MYSQL_USER=kadr
MYSQL_PASSWORD=change_me_pass

# ── App ──────────────────────────────────────────────────
# Konteyner ichida DB xosti = "db"
DATABASE_URL=mysql://kadr:change_me_pass@db:3306/kadr_db

# JWT sessiya kaliti — production'da uzun, tasodifiy qiymat qo'ying
SESSION_SECRET=change_me_to_a_long_random_string

# nginx orqali HTTP (TLS yo'q) bo'lsa 1 qoldiring; HTTPS bo'lsa 0 qiling
FORCE_INSECURE_COOKIE=1

NODE_ENV=production
