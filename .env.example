# ─────────────────────────────────────────────────────────────────────
#  Kadr Tizimi — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env   (so'ng qiymatlarni to'ldiring)
#  .env HECH QACHON git yoki Docker image'ga tushmasligi kerak (.gitignore/.dockerignore)
# ─────────────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=kadr_db
MYSQL_USER=kadr
MYSQL_PASSWORD=change_me_pass

# ── App ──────────────────────────────────────────────────
# Konteyner ichida DB xosti = "db" (compose service nomi)
DATABASE_URL=mysql://kadr:change_me_pass@db:3306/kadr_db

# JWT sessiya kaliti — kamida 32 belgi, tasodifiy.
# Yaratish:  openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# Cookie xavfsizligi:
#   1 = Secure bayrog'i O'CHIRILADI (nginx orqali oddiy HTTP, TLS yo'q — lokal/demo).
#   0 = Secure YOQILADI (HTTPS bo'lganda — PRODUCTION uchun majburiy).
# Internetga chiqarishda TLS o'rnating va bu qiymatni 0 qiling.
FORCE_INSECURE_COOKIE=1

NODE_ENV=production

# ── E-IMZO (elektron raqamli imzo) — kelajakdagi integratsiya ────────
# server = Node lokal E-IMZO bilan (desktop deploy) · client = brauzer o'z E-IMZO'si bilan (remote)
# EIMZO_MODE=server
# NEXT_PUBLIC_EIMZO_API_KEY=
# EIMZO_WS_URL=wss://127.0.0.1:64443/service/cryptapi
